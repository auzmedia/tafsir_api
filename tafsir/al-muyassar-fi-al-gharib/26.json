[
  {
    "text": "﴿ٱلۡكِتَـٰبِ﴾: القرآنِ.",
    "ayah": 2,
    "surah": 26
  },
  {
    "text": "﴿بَـٰخِعࣱ نَّفۡسَكَ﴾: مُهْلِكُها غَمًّا وحُزْنًا.",
    "ayah": 3,
    "surah": 26
  },
  {
    "text": "﴿ءَايَةࣰ﴾: مُعْجِزَةً.\n\n﴿خَـٰضِعِينَ﴾: مُنْقادِينَ بالكُرْهِ مِنهُم.",
    "ayah": 4,
    "surah": 26
  },
  {
    "text": "﴿مُحۡدَثٍ﴾: أي: مُجَدَّدٍ إنْزالُه.",
    "ayah": 5,
    "surah": 26
  },
  {
    "text": "﴿أَوَ لَمۡ يَرَوۡاْ﴾: أوَلَم يَنْظُرُوا.\n\n﴿زَوۡجࣲ كَرِيمٍ﴾: صِنْفٍ حَسَنٍ كَثِيرِ النَّفْعِ.",
    "ayah": 7,
    "surah": 26
  },
  {
    "text": "﴿لَـَٔايَةࣰ﴾: لَدَلالةً واضِحَةً.",
    "ayah": 8,
    "surah": 26
  },
  {
    "text": "﴿أَلَا يَتَّقُونَ﴾: ألا يَخافُونَ عِقابَ اللهِ تعالى؟",
    "ayah": 11,
    "surah": 26
  },
  {
    "text": "﴿ذَنۢبࣱ﴾: وهو قَتْلُ القِبْطِيِّ.",
    "ayah": 14,
    "surah": 26
  },
  {
    "text": "﴿بِـَٔايَـٰتِنَآ﴾: بِمُعْجزاتِنا وحُجَجِنا.\n\n﴿إِنَّا مَعَكُم﴾: أي: بالعِلْمِ والحِفْظِ والنُّصْرَةِ.",
    "ayah": 15,
    "surah": 26
  },
  {
    "text": "﴿أَلَمۡ نُرَبِّكَ﴾: ألم نَرْعَكَ.\n\n﴿وَلِيدࣰا﴾: صَغِيرًا.",
    "ayah": 18,
    "surah": 26
  },
  {
    "text": "﴿فَعۡلَتَكَ﴾: أي: قَتْلَ القِبْطِيِّ.\n\n﴿مِنَ ٱلۡكَـٰفِرِينَ﴾: أي: من الجاحِدِينَ لِنِعْمَتِي.",
    "ayah": 19,
    "surah": 26
  },
  {
    "text": "﴿مِنَ ٱلضَّآلِّينَ﴾: مِنَ المُخْطِئِينَ لا المتعَمِّدِينَ.",
    "ayah": 20,
    "surah": 26
  },
  {
    "text": "﴿حُكۡمࣰا﴾: أي: نُبُوَّةً وحِكْمَةً.",
    "ayah": 21,
    "surah": 26
  },
  {
    "text": "﴿تَمُنُّهَا عَلَيَّ﴾: تَعُدُّها نِعْمَةً مِنكَ عليّ.\n\n﴿عَبَّدتَّ﴾: جَعَلْتَهُم عَبِيدًا تَذْبَحُ مَن تَشاءُ وتَتْرُكُ مَن تَشاءُ مِن أبْنائِهِم وتَسْتَبْقِي نِساءَهُم لِلْخِدْمَةِ والامْتِهانِ.",
    "ayah": 22,
    "surah": 26
  },
  {
    "text": "﴿بِشَيۡءࣲ مُّبِينࣲ﴾: أي: بِبُرْهانٍ قاطِعٍ.",
    "ayah": 30,
    "surah": 26
  },
  {
    "text": "﴿بَيۡضَآءُ﴾: أي: مِن غَيرِ مَرَضٍ ولا بَرَصٍ.",
    "ayah": 33,
    "surah": 26
  },
  {
    "text": "﴿لِلۡمَلَإِ﴾: لأشْرافِ قَوْمِهِ.\n\n﴿لَسَـٰحِرٌ عَلِيمࣱ﴾: أي: ساحِرٌ ماهِرٌ.",
    "ayah": 34,
    "surah": 26
  },
  {
    "text": "﴿أَرۡجِهۡ﴾: أخِّرْهُ.\n\n﴿ٱلۡمَدَآئِنِ﴾: المُدُنِ.\n\n﴿حَـٰشِرِينَ﴾: جامِعِينَ للسَّحَرةِ.",
    "ayah": 36,
    "surah": 26
  },
  {
    "text": "﴿تَلۡقَفُ﴾: تَبْتَلِعُ بِسُرْعَةٍ.\n\n﴿مَا يَأۡفِكُونَ﴾: ما يَكْذِبُونَهُ ويُمَوِّهُونَهُ.",
    "ayah": 45,
    "surah": 26
  },
  {
    "text": "﴿مِّنۡ خِلَـٰفࣲ﴾: أي: بِقَطْعِ اليَدِ اليُمْنى والرِّجْلِ اليُسْرى أو عَكْسِ ذَلِك.\n\n﴿وَلَأُصَلِّبَنَّكُمۡ﴾: ولَأُبالِغَنَّ في شَدِّ أطْرافِكُم ورَبْطِ أجْسادِكُم على جُذُوعِ النَّخْلِ.",
    "ayah": 49,
    "surah": 26
  },
  {
    "text": "﴿لَا ضَيۡرَ﴾: لا ضَرَرَ عَلَينا فِيما يُصِيبُنا.\n\n﴿مُنقَلِبُونَ﴾: راجِعُونَ.",
    "ayah": 50,
    "surah": 26
  },
  {
    "text": "﴿أَوَّلَ ٱلۡمُؤۡمِنِينَ﴾: أي: مِن قَومِ فِرْعَونَ.",
    "ayah": 51,
    "surah": 26
  },
  {
    "text": "﴿أَنۡ أَسۡرِ بِعِبَادِيٓ﴾: أي: اخْرُجْ بِهِم لَيْلًا.\n\n﴿مُّتَّبَعُونَ﴾: يَتَّبِعُكُم فِرْعَونُ وجُنُودُه.",
    "ayah": 52,
    "surah": 26
  },
  {
    "text": "﴿ٱلۡمَدَآئِنِ﴾: المُدُنِ.\n\n﴿حَـٰشِرِينَ﴾: جامِعِينَ لِلْجَيشِ.",
    "ayah": 53,
    "surah": 26
  },
  {
    "text": "﴿لَشِرۡذِمَةࣱ﴾: لَطائِفَةٌ حَقِيرَةٌ قَلِيلةُ العَدَدِ.",
    "ayah": 54,
    "surah": 26
  },
  {
    "text": "﴿لَنَا لَغَآئِظُونَ﴾: لَمُغْضِبُونا بِخُرُوجِهِم مِن غَيْرِ إذْنٍ مِنّا.",
    "ayah": 55,
    "surah": 26
  },
  {
    "text": "﴿حَـٰذِرُونَ﴾: مُتَيَقِّظُونَ.",
    "ayah": 56,
    "surah": 26
  },
  {
    "text": "﴿جَنَّـٰتࣲ﴾: بَساتِينَ.",
    "ayah": 57,
    "surah": 26
  },
  {
    "text": "﴿مُّشۡرِقِينَ﴾: وقْتَ شُرُوقِ الشَّمْسِ.",
    "ayah": 60,
    "surah": 26
  },
  {
    "text": "﴿ٱلۡجَمۡعَانِ﴾: جَمْعُ مُوسى وهُم بنُو إسْرائيلَ، وجَمْعُ فِرْعَونَ وهم القِبْطُ.\n\n﴿لَمُدۡرَكُونَ﴾: لَمُلحَقُون من قِبَلِ فِرْعَونَ وجُنُودِهِ.",
    "ayah": 61,
    "surah": 26
  },
  {
    "text": "﴿فَٱنفَلَقَ﴾: أي: انْشَقَّ البَحْرُ إلى اثْنَي عَشْرَ طَرِيقًا.\n\n﴿فِرۡقࣲ﴾: قِطْعةٍ من البحْرِ مُرْتَفِعَةٍ.\n\n﴿كَٱلطَّوۡدِ﴾: كالجَبَلِ المُتَطاوِلِ في السَّماءِ.",
    "ayah": 63,
    "surah": 26
  },
  {
    "text": "﴿وَأَزۡلَفۡنَا﴾: وقَرَّبْنا.\n\n﴿ثَمَّ﴾: هُناك.\n\n﴿ٱلۡـَٔاخَرِينَ﴾: وهم فِرْعَونُ وقَوْمُه.",
    "ayah": 64,
    "surah": 26
  },
  {
    "text": "﴿لَـَٔايَةࣰ﴾: لَعِبرةً عَجِيبةً.",
    "ayah": 67,
    "surah": 26
  },
  {
    "text": "﴿لَهَا عَـٰكِفِينَ﴾: على عِبادتِها مُقِيمِينَ على الدَّوامِ.",
    "ayah": 71,
    "surah": 26
  },
  {
    "text": "﴿أَفَرَءَيۡتُم﴾: هَل تأمَّلْتُم ما أنْتُم عَلَيه؟",
    "ayah": 75,
    "surah": 26
  },
  {
    "text": "﴿يَوۡمَ ٱلدِّينِ﴾: يومَ الجَزاءِ.",
    "ayah": 82,
    "surah": 26
  },
  {
    "text": "﴿حُكۡمࣰا﴾: عِلْمًا وفَهْمًا.",
    "ayah": 83,
    "surah": 26
  },
  {
    "text": "﴿لِسَانَ صِدۡقࣲ﴾: ثَناءً حَسَنًا.\n\n﴿فِي ٱلۡـَٔاخِرِينَ﴾: أي: في الَّذينَ يأتُونَ بَعْدِي إلى يومِ القِيامَةِ.",
    "ayah": 84,
    "surah": 26
  },
  {
    "text": "﴿وَلَا تُخۡزِنِي﴾: ولا تَفْضَحْنِي.",
    "ayah": 87,
    "surah": 26
  },
  {
    "text": "﴿بِقَلۡبࣲ سَلِيمࣲ﴾: أي: مِنَ النِّفاقِ والكُفْرِ.",
    "ayah": 89,
    "surah": 26
  },
  {
    "text": "﴿وَأُزۡلِفَتِ﴾: قُرِّبَتْ.",
    "ayah": 90,
    "surah": 26
  },
  {
    "text": "﴿وَبُرِّزَتِ﴾: أُظْهِرَتْ.\n\n﴿لِلۡغَاوِينَ﴾: للضّالِينَ عَن طَرِيقِ الهِدايةِ.",
    "ayah": 91,
    "surah": 26
  },
  {
    "text": "﴿فَكُبۡكِبُواْ فِيهَا﴾: أُلْقُوا في جَهَنَّمَ على وُجُوهِهِم مرَّةً بَعْدَ مَرَّةٍ إلى أنِ اسْتَقرُّوا في قَعْرِها.",
    "ayah": 94,
    "surah": 26
  },
  {
    "text": "﴿يَخۡتَصِمُونَ﴾: يَتَنازَعُون.",
    "ayah": 96,
    "surah": 26
  },
  {
    "text": "﴿إِن كُنَّا﴾: إنَّنا كُنّا.",
    "ayah": 97,
    "surah": 26
  },
  {
    "text": "﴿نُسَوِّيكُم بِرَبِّ ٱلۡعَـٰلَمِينَ﴾: نَجْعَلُكُم مِثْلَ رَبِّ العالَمِينَ.",
    "ayah": 98,
    "surah": 26
  },
  {
    "text": "﴿شَـٰفِعِينَ﴾: فَيُخَلِّصُونا مِنَ العَذابِ.",
    "ayah": 100,
    "surah": 26
  },
  {
    "text": "﴿حَمِيمࣲ﴾: قَرِيبٍ ومُشْفِقٍ.",
    "ayah": 101,
    "surah": 26
  },
  {
    "text": "﴿كَرَّةࣰ﴾: رَجْعَةً إلى الدُّنيا.",
    "ayah": 102,
    "surah": 26
  },
  {
    "text": "﴿ٱلۡأَرۡذَلُونَ﴾: أي: أسافلُ النّاسِ وأَراذِلُهم.",
    "ayah": 111,
    "surah": 26
  },
  {
    "text": "﴿ٱلۡمَرۡجُومِينَ﴾: مِنَ المقْتُولِينَ رَمْيًا بالحِجارَةِ.",
    "ayah": 116,
    "surah": 26
  },
  {
    "text": "﴿فَٱفۡتَحۡ﴾: فاحْكُمْ.",
    "ayah": 118,
    "surah": 26
  },
  {
    "text": "﴿ٱلۡمَشۡحُونِ﴾: المَمْلُوءِ بالنّاسِ والدَّوابِّ والمتاعِ.",
    "ayah": 119,
    "surah": 26
  },
  {
    "text": "﴿رِيعٍ﴾: مكانٍ مُرْتَفِعٍ.\n\n﴿ءَايَةࣰ﴾: بِناءً شامِخًا.",
    "ayah": 128,
    "surah": 26
  },
  {
    "text": "﴿مَصَانِعَ﴾: حُصُونًا أو قُصُورًا.\n\n﴿تَخۡلُدُونَ﴾: أي: تَبْقَونَ في الدُّنيا ولا تَمُوتُونَ.",
    "ayah": 129,
    "surah": 26
  },
  {
    "text": "﴿بَطَشۡتُم﴾: أخَذْتُم بِعُنْفٍ.\n\n﴿جَبَّارِينَ﴾: قاهِرِينَ ظالِمِين.",
    "ayah": 130,
    "surah": 26
  },
  {
    "text": "﴿أَمَدَّكُم﴾: أنْعَمَ عليكُم وأَعْطاكُم.",
    "ayah": 132,
    "surah": 26
  },
  {
    "text": "﴿بِأَنۡعَـٰمࣲ﴾: مِنَ الإبِلِ والبَقَرِ والغَنَمِ.",
    "ayah": 133,
    "surah": 26
  },
  {
    "text": "﴿وَجَنَّـٰتࣲ﴾: حَدائِقَ وبَساتِينَ.",
    "ayah": 134,
    "surah": 26
  },
  {
    "text": "﴿إِنۡ هَـٰذَآ﴾: ما هَذا.\n\n﴿خُلُقُ ٱلۡأَوَّلِينَ﴾: دِينُ الأوَّلِينَ وعاداتُهُم.",
    "ayah": 137,
    "surah": 26
  },
  {
    "text": "﴿مَا هَـٰهُنَآ﴾: أي: في الدُّنيا.",
    "ayah": 146,
    "surah": 26
  },
  {
    "text": "﴿طَلۡعُهَا﴾: ثَمَرُها.\n\n﴿هَضِيمࣱ﴾: مُنْكَسِرٌ مِن لِينِهِ ورُطُوبَتِه.",
    "ayah": 148,
    "surah": 26
  },
  {
    "text": "﴿فَـٰرِهِينَ﴾: ماهِرِين بنَحْتِها.",
    "ayah": 149,
    "surah": 26
  },
  {
    "text": "﴿مِنَ ٱلۡمُسَحَّرِينَ﴾: مِنَ المغْلُوبِ على عُقُولِهِم بِكَثْرَةِ السِّحرِ.",
    "ayah": 153,
    "surah": 26
  },
  {
    "text": "﴿بِـَٔايَةٍ﴾: بِحُجَّةٍ واضِحَةٍ.",
    "ayah": 154,
    "surah": 26
  },
  {
    "text": "﴿لَّهَا شِرۡبࣱ﴾: لها نَصِيبٌ مِنَ الماءِ.",
    "ayah": 155,
    "surah": 26
  },
  {
    "text": "﴿فَعَقَرُوهَا﴾: فَنَحَرُوها.",
    "ayah": 157,
    "surah": 26
  },
  {
    "text": "﴿أَتَأۡتُونَ ٱلذُّكۡرَانَ﴾: أتَنْكِحُونَ الرِّجالَ؟",
    "ayah": 165,
    "surah": 26
  },
  {
    "text": "﴿وَتَذَرُونَ﴾: وتَتْرُكُونَ.\n\n﴿عَادُونَ﴾: مُتَجاوِزُونَ ما أباحَهُ اللهُ لَكُم مِنَ الحَلالِ إلى الحَرامِ.",
    "ayah": 166,
    "surah": 26
  },
  {
    "text": "﴿مِّنَ ٱلۡقَالِينَ﴾: مِنَ المُبْغِضِينَ أشَدَّ البُغْضِ.",
    "ayah": 168,
    "surah": 26
  },
  {
    "text": "﴿فِي ٱلۡغَـٰبِرِينَ﴾: في الباقِينَ في العذابِ والهلاكِ.",
    "ayah": 171,
    "surah": 26
  },
  {
    "text": "﴿دَمَّرۡنَا﴾: أهْلَكْنا.",
    "ayah": 172,
    "surah": 26
  },
  {
    "text": "﴿أَصۡحَـٰبُ لۡـَٔيۡكَةِ﴾: أصْحابُ الشَّجَرِ المُلْتَفِّ.",
    "ayah": 176,
    "surah": 26
  },
  {
    "text": "﴿مِنَ ٱلۡمُخۡسِرِينَ﴾: مِنَ النّاقِصِينَ للحُقُوقِ بالتَّطفِيفِ.",
    "ayah": 181,
    "surah": 26
  },
  {
    "text": "﴿بِٱلۡقِسۡطَاسِ﴾: بالميزانِ.",
    "ayah": 182,
    "surah": 26
  },
  {
    "text": "﴿وَلَا تَبۡخَسُواْ﴾: ولا تَنْقُصُوا.\n\n﴿وَلَا تَعۡثَوۡاْ﴾: ولا تُفْسِدُوا أشَدَّ الإفْسادِ.",
    "ayah": 183,
    "surah": 26
  },
  {
    "text": "﴿وَٱلۡجِبِلَّةَ ٱلۡأَوَّلِينَ﴾: والخَلائِقَ من الأُمَمِ المتقدِّمةِ.",
    "ayah": 184,
    "surah": 26
  },
  {
    "text": "﴿مِنَ ٱلۡمُسَحَّرِينَ﴾: مِنَ المغلُوبِ على عُقُولِهِم بِكَثْرَةِ السِّحْرِ.",
    "ayah": 185,
    "surah": 26
  },
  {
