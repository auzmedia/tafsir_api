[
  {
    "text": "﴿هَلۡ﴾: قَدْ.\n\n﴿ٱلۡغَـٰشِيَةِ﴾: القِيامةِ الَّتِي تَغْشى النّاسَ بأهْوالِها.",
    "ayah": 1,
    "surah": 88
  },
  {
    "text": "﴿وُجُوهࣱ﴾: وُجُوهُ الكُفّارِ.\n\n﴿خَـٰشِعَةٌ﴾: ذَلِيلةٌ بالعذابِ.",
    "ayah": 2,
    "surah": 88
  },
  {
    "text": "﴿عَامِلَةࣱ﴾: مُجْهَدَةٌ بالعَمَلِ.\n\n﴿نَّاصِبَةࣱ﴾: مُتْعَبَةٌ.",
    "ayah": 3,
    "surah": 88
  },
  {
    "text": "﴿تَصۡلَىٰ﴾: تُقاسِي نارًا.\n\n﴿حَامِيَةࣰ﴾: شَدِيدَة التَّوَهُّجِ.",
    "ayah": 4,
    "surah": 88
  },
  {
    "text": "﴿ءَانِيَةࣲ﴾: بَلَغَتْ مُنْتَهى الحرارةِ.",
    "ayah": 5,
    "surah": 88
  },
  {
    "text": "﴿ضَرِيعࣲ﴾: نَبْتٍ ذي شَوْكٍ لاصِقٍ بالأرْضِ.",
    "ayah": 6,
    "surah": 88
  },
  {
    "text": "﴿وَلَا يُغۡنِي مِن جُوعࣲ﴾: ولا يَسُدُّ جُوعَهُ.",
    "ayah": 7,
    "surah": 88
  },
  {
    "text": "﴿وُجُوهࣱ﴾: وُجُوهُ المؤمِنينَ.\n\n﴿نَّاعِمَةࣱ﴾: ذاتُ نِعْمَةٍ وكَرامةٍ.",
    "ayah": 8,
    "surah": 88
  },
  {
    "text": "﴿لِّسَعۡيِهَا﴾: لِعَمَلِها الَّذِي عَمِلَتْهُ في الدُّنيا.\n\n﴿رَاضِيَةࣱ﴾: في الآخِرَةِ حِينَ أُعْطِيَتِ الجنَّةَ بِعَمَلِها.",
    "ayah": 9,
    "surah": 88
  },
  {
    "text": "﴿عَالِيَةࣲ﴾: رَفِيعةِ المكانِ والمكانةِ.",
    "ayah": 10,
    "surah": 88
  },
  {
    "text": "﴿لَـٰغِيَةࣰ﴾: كَلِمةَ لَغْوٍ.",
    "ayah": 11,
    "surah": 88
  },
  {
    "text": "﴿جَارِيَةࣱ﴾: تَتَدَفَّقُ مِياهُها.",
    "ayah": 12,
    "surah": 88
  },
  {
    "text": "﴿مَّوۡضُوعَةࣱ﴾: مُعَدَّةٌ للشّارِبِينَ.",
    "ayah": 14,
    "surah": 88
  },
  {
    "text": "﴿وَنَمَارِقُ﴾: ووَسائِدُ ومَرافِقُ.\n\n﴿مَصۡفُوفَةࣱ﴾: بَعضُها بِجَنبِ بَعْضٍ.",
    "ayah": 15,
    "surah": 88
  },
  {
    "text": "﴿وَزَرَابِيُّ﴾: وبُسُطٌ.\n\n﴿مَبۡثُوثَةٌ﴾: كَثِيرةٌ مَفْرُوشَةٌ.",
    "ayah": 16,
    "surah": 88
  },
  {
    "text": "﴿كَيۡفَ رُفِعَتۡ﴾: عَنِ الأرْضِ بِلا عَمَدٍ؟",
    "ayah": 18,
    "surah": 88
  },
  {
    "text": "﴿نُصِبَتۡ﴾: رُفِعتْ حتّى كانتْ بارزةً على وجْهِ الأرضِ.",
    "ayah": 19,
    "surah": 88
  },
  {
    "text": "﴿سُطِحَتۡ﴾: بُسِطَتْ و مُهِّدتْ.",
    "ayah": 20,
    "surah": 88
  },
  {
    "text": "﴿فَذَكِّرۡ﴾: فَعِظْ.\n\n﴿مُذَكِّرࣱ﴾: واعِظٌ.",
    "ayah": 21,
    "surah": 88
  },
  {
    "text": "﴿بِمُصَيۡطِرٍ﴾: بِمُسَلَّطٍ، فَتُكْرِهَهُم على الإيمانِ.",
    "ayah": 22,
    "surah": 88
  },
  {
    "text": "﴿تَوَلَّىٰ﴾: أعْرَضَ وأصَرَّ عَلى الكُفْرِ.",
    "ayah": 23,
    "surah": 88
  },
  {
    "text": "﴿ٱلۡعَذَابَ ٱلۡأَكۡبَرَ﴾: النّارَ.",
    "ayah": 24,
    "surah": 88
  },
  {
    "text": "﴿إِيَابَهُمۡ﴾: مَرْجِعَهُم بَعْدَ الموتِ.",
    "ayah": 25,
    "surah": 88
  },
  {
    "text": "﴿حِسَابَهُم﴾: جَزاءَهُم.",
    "ayah": 26,
    "surah": 88
  }
]
