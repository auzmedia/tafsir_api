[
  {
    "text": "﴿وَٱلصَّـٰٓفَّـٰتِ﴾: هي الملائِكَةُ التي تَصْطَفُّ في عِبادَتِها.",
    "ayah": 1,
    "surah": 37
  },
  {
    "text": "﴿فَٱلزَّ ٰ⁠جِرَ ٰ⁠تِ﴾: هي الملائكةُ التي تَزْجُرُ السَّحابَ وتَسُوقُه.",
    "ayah": 2,
    "surah": 37
  },
  {
    "text": "﴿ذِكۡرًا﴾: هو القرآنُ.",
    "ayah": 3,
    "surah": 37
  },
  {
    "text": "﴿ٱلۡكَوَاكِبِ﴾: النُّجُومِ.",
    "ayah": 6,
    "surah": 37
  },
  {
    "text": "﴿مَّارِدࣲ﴾: مُتَمَرِّدٍ خارجٍ عَنِ الطّاعةِ.",
    "ayah": 7,
    "surah": 37
  },
  {
    "text": "﴿وَيُقۡذَفُونَ﴾: ويُرجَمُونَ (بالشُّهُبِ).",
    "ayah": 8,
    "surah": 37
  },
  {
    "text": "﴿دُحُورࣰا﴾: إبْعادًا وطَرْدًا.\n\n﴿وَاصِبٌ﴾: دائمٌ لا يَنْقَطِعُ.",
    "ayah": 9,
    "surah": 37
  },
  {
    "text": "﴿خَطِفَ ٱلۡخَطۡفَةَ﴾: أي: اسْتَرَقَ السَّمْعَ خِلْسةً.\n\n﴿فَأَتۡبَعَهُۥ﴾: تَبِعَه ولحِقَه.\n\n﴿شِهَابࣱ ثَاقِبࣱ﴾: نَجْمٌ مُضِيءٌ.",
    "ayah": 10,
    "surah": 37
  },
  {
    "text": "﴿لَّازِبِۭ﴾: مُلْتَزِقٍ بَعْضُه ببَعْضٍ.",
    "ayah": 11,
    "surah": 37
  },
  {
    "text": "﴿وَيَسۡخَرُونَ﴾: يَسْتَهْزِئُونَ بِكَ.",
    "ayah": 12,
    "surah": 37
  },
  {
    "text": "﴿ءَايَةࣰ﴾: مُعْجِزَةً مِن مُّعْجِزاتِكَ.\n\n﴿يَسۡتَسۡخِرُونَ﴾: يبالِغُونَ في سُخْرِيَّتِهِم.",
    "ayah": 14,
    "surah": 37
  },
  {
    "text": "﴿دَ ٰ⁠خِرُونَ﴾: أذِلّاءُ صاغِرُونَ.",
    "ayah": 18,
    "surah": 37
  },
  {
    "text": "﴿زَجۡرَةࣱ وَ ٰ⁠حِدَةࣱ﴾: نَفْخَةٌ واحِدَةٌ.",
    "ayah": 19,
    "surah": 37
  },
  {
    "text": "﴿يَـٰوَيۡلَنَا﴾: يا هَلاكَنا.",
    "ayah": 20,
    "surah": 37
  },
  {
    "text": "﴿يَوۡمُ ٱلۡفَصۡلِ﴾: يومُ القضاءِ بَيْنَ الخَلْقِ.",
    "ayah": 21,
    "surah": 37
  },
  {
    "text": "﴿ٱحۡشُرُواْ﴾: اجْمَعُوا.\n\n﴿وَأَزۡوَ ٰ⁠جَهُمۡ﴾: قُرَناءَهُم ونُظراءَهُم.",
    "ayah": 22,
    "surah": 37
  },
  {
    "text": "﴿فَٱهۡدُوهُمۡ إِلَىٰ صِرَ ٰ⁠طِ ٱلۡجَحِيمِ﴾: دُلُّوهُم إلى طَرِيقِ النّارِ، وسُوقُوهُم إليها.",
    "ayah": 23,
    "surah": 37
  },
  {
    "text": "﴿وَقِفُوهُمۡ﴾: احْبِسُوهُم في مَوْقِفِ الحِسابِ.",
    "ayah": 24,
    "surah": 37
  },
  {
    "text": "﴿مُسۡتَسۡلِمُونَ﴾: مُنْقادُونَ أذلّاءُ لِعَجِزِهِم عَنِ الحِيلَةِ.",
    "ayah": 26,
    "surah": 37
  },
  {
    "text": "﴿عَنِ ٱلۡيَمِينِ﴾: أي: عَنِ النّاحيةِ الَّتي كان مِنها الحقُّ، فَتَصْرِفُونَنا عَنْها.",
    "ayah": 28,
    "surah": 37
  },
  {
    "text": "﴿طَـٰغِينَ﴾: متجاوِزِينَ الحَدَّ في الكُفْرِ والضَّلالِ.",
    "ayah": 30,
    "surah": 37
  },
  {
    "text": "﴿فَحَقَّ﴾: ثَبَتَ ووَجَبَ.",
    "ayah": 31,
    "surah": 37
  },
  {
    "text": "﴿فَأَغۡوَيۡنَـٰكُمۡ﴾: فأَضْلَلْناكُم.\n\n﴿غَـٰوِينَ﴾: ضالِّيِنَ.",
    "ayah": 32,
    "surah": 37
  },
  {
    "text": "﴿يُطَافُ﴾: يُدارُ.\n\n﴿بِكَأۡسࣲ﴾: بِكأسٍ مِن خمْرٍ.\n\n﴿مَّعِينِۭ﴾: نابِعٍ مِنَ العُيوَنِ.",
    "ayah": 45,
    "surah": 37
  },
  {
    "text": "﴿لَا فِيهَا غَوۡلࣱ﴾: لا أذىً فيها ولا مَكْروهٌ على شاربيها.\n\n﴿وَلَا هُمۡ عَنۡهَا يُنزَفُونَ﴾: ولا هم عَن شُرْبِها تَذْهَبُ عُقُولُهم، أي: لا تُنزَفُ عُقُولُهم كما يُنْزَفَ دَمُ الجَرِيحِ.",
    "ayah": 47,
    "surah": 37
  },
  {
    "text": "﴿قَـٰصِرَ ٰ⁠تُ ٱلطَّرۡفِ﴾: حُورٌ قَصَرْنَ نَظَرَهُنَّ على أزْواجِهِنَّ.\n\n﴿عِينࣱ﴾: جَمْعُ «عَيناءَ»: واسعةُ العَينِ حَسَنَتُها.",
    "ayah": 48,
    "surah": 37
  },
  {
    "text": "﴿مَّكۡنُونࣱ﴾: مَصُونٌ لم يَمْسَسْهُ أحَدٌ.",
    "ayah": 49,
    "surah": 37
  },
  {
    "text": "﴿قَرِينࣱ﴾: صاحِبٌ مُلازِمٌ.",
    "ayah": 51,
    "surah": 37
  },
  {
    "text": "﴿لَمَدِينُونَ﴾: لَمَجْزِيُّونَ ومُحاسَبُونَ.",
    "ayah": 53,
    "surah": 37
  },
  {
    "text": "﴿سَوَآءِ ٱلۡجَحِيمِ﴾: وسَطِها.",
    "ayah": 55,
    "surah": 37
  },
  {
    "text": "﴿تَٱللَّهِ﴾: واللهِ.\n\n﴿كِدتَّ﴾: قارَبْتَ.\n\n﴿لَتُرۡدِينِ﴾: لَتُهْلِكُنِي.",
    "ayah": 56,
    "surah": 37
  },
  {
    "text": "﴿ٱلۡمُحۡضَرِينَ﴾: أي: في العذابِ مِثلَك.",
    "ayah": 57,
    "surah": 37
  },
  {
    "text": "﴿نُّزُلًا﴾: ما يُهَيَّأُ للنَّزيلِ إكْرامًا لهُ.\n\n﴿شَجَرَةُ ٱلزَّقُّومِ﴾: الشَّجَرَةُ الخَبيَثةُ الملعُونةُ ذاتُ الثَّمرِ المُرِّ الكرِيهِ الرّائِحَةِ.",
    "ayah": 62,
    "surah": 37
  },
  {
    "text": "﴿فِتۡنَةࣰ لِّلظَّـٰلِمِينَ﴾: مِحْنَةً لَهُم لِكَوْنِهِم يُعَذَّبُونَ بِها في الآخِرةِ.",
    "ayah": 63,
    "surah": 37
  },
  {
    "text": "﴿تَخۡرُجُ﴾: تَنْبُتُ.\n\n﴿أَصۡلِ ٱلۡجَحِيمِ﴾: قَعْرِ جَهَنَّمَ.",
    "ayah": 64,
    "surah": 37
  },
  {
    "text": "﴿طَلۡعُهَا﴾: ثَمَرُها.\n\n﴿كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ﴾: تشبيهٌ للمَحْسُوسِ بالمتَخَيَّلِ؛ لِتناهِيهِ في البَشاعَةِ والقُبْحِ.",
    "ayah": 65,
    "surah": 37
  },
  {
    "text": "﴿لَشَوۡبࣰا﴾: لخَلْطًا ومِزاجًا.\n\n﴿مِّنۡ حَمِيمࣲ﴾: الماءِ الحارِّ الشَّديدِ الحرارةِ.",
    "ayah": 67,
    "surah": 37
  },
  {
    "text": "﴿مَرۡجِعَهُمۡ﴾: مَرَدَّهُم.\n\n﴿ٱلۡجَحِيمِ﴾: جَهَنَّمَ.",
    "ayah": 68,
    "surah": 37
  },
  {
    "text": "﴿أَلۡفَوۡاْ﴾: وجَدُوا.",
    "ayah": 69,
    "surah": 37
  },
  {
    "text": "﴿يُهۡرَعُونَ﴾: يُسْرِعُونَ إلى متابعةِ آبائِهِم الضّالِّينَ.",
    "ayah": 70,
    "surah": 37
  },
  {
    "text": "﴿مُّنذِرِينَ﴾: مُرسَلِينَ.",
    "ayah": 72,
    "surah": 37
  },
  {
    "text": "﴿ٱلۡكَرۡبِ ٱلۡعَظِيمِ﴾: الغَرَقِ بالطُّوفانِ العظيمِ.",
    "ayah": 76,
    "surah": 37
  },
  {
    "text": "﴿ٱلۡـَٔاخِرِينَ﴾: الَّذينَ جاؤُوا بَعْدَه.",
    "ayah": 78,
    "surah": 37
  },
  {
    "text": "﴿ٱلۡـَٔاخَرِينَ﴾: الباقِينَ الَّذين كذَّبوُا نوحًا عليه الصَّلاةُ والسَّلامُ.",
    "ayah": 82,
    "surah": 37
  },
  {
    "text": "﴿شِيعَتِهِۦ﴾: أي: جَماعَتِهِ الَّذينَ هُمُ الأنبِياءُ والمرْسَلُونَ عليهم الصَّلاةُ والسَّلامُ.",
    "ayah": 83,
    "surah": 37
  },
  {
    "text": "﴿أَئِفۡكًا﴾: أكَذِبًا وباطِلًا.",
    "ayah": 86,
    "surah": 37
  },
  {
    "text": "﴿فَنَظَرَ﴾: تَأَمَّلَ.",
    "ayah": 88,
    "surah": 37
  },
  {
    "text": "﴿سَقِيمࣱ﴾: مَرِيضٌ.",
    "ayah": 89,
    "surah": 37
  },
  {
    "text": "﴿فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ﴾: فانصَرَفُوا عنه مُعْرِضِين.",
    "ayah": 90,
    "surah": 37
  },
  {
    "text": "﴿فَرَاغَ إِلَىٰٓ﴾: ذَهَبَ خُفْيَةً.",
    "ayah": 91,
    "surah": 37
  },
  {
    "text": "﴿فَرَاغَ عَلَيۡهِمۡ﴾: مالَ وأَقْبَل عَلَيهِم.\n\n﴿بِٱلۡيَمِينِ﴾: أي: بيَدِه اليُمْنى.",
    "ayah": 93,
    "surah": 37
  },
  {
    "text": "﴿يَزِفُّونَ﴾: يُسْرِعُونَ في مَشْيِهِم.",
    "ayah": 94,
    "surah": 37
  },
  {
    "text": "﴿تَنۡحِتُونَ﴾: تَبْرُونَ وتَقْشِرُونَ بِأَيْدِيكُم.",
    "ayah": 95,
    "surah": 37
  },
  {
    "text": "﴿ٱلۡجَحِيمِ﴾: النّارِ الشَّديدةِ الاتِّقادِ.",
    "ayah": 97,
    "surah": 37
  },
  {
    "text": "﴿ٱلۡأَسۡفَلِينَ﴾: المقْهُورِينَ المغْلُوبِينَ.",
    "ayah": 98,
    "surah": 37
  },
  {
    "text": "﴿حَلِيمࣲ﴾: أي: عِنْدَما يَكْبَر.",
    "ayah": 101,
    "surah": 37
  },
  {
    "text": "﴿أَسۡلَمَا﴾: اسْتَسْلَما لأمْرِ اللهِ وانْقادا لَه.\n\n﴿وَتَلَّهُۥ لِلۡجَبِينِ﴾: أي: أضْجَعَه على جَبينِه على الأرضِ.",
    "ayah": 103,
    "surah": 37
  },
  {
    "text": "﴿ٱلۡبَلَـٰٓؤُاْ ٱلۡمُبِينُ﴾: الاخْتِبارُ الواضِحُ.",
    "ayah": 106,
    "surah": 37
  },
  {
    "text": "﴿بِذِبۡحٍ عَظِيمࣲ﴾: بكَبْشٍ مَذْبُوحٍ عَظِيمِ القَدْرِ.",
    "ayah": 107,
    "surah": 37
  },
  {
    "text": "﴿عَلَيۡهِ﴾: أي: على ذِكْرِه الحَسَنِ.\n\n﴿فِي ٱلۡـَٔاخِرِينَ﴾: في الأُمَمِ التي جاءتْ بَعْدَه.",
    "ayah": 108,
    "surah": 37
  },
  {
    "text": "﴿مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ﴾: أي: مِنَ الغَرَقِ وتَسَلُّطِ فِرْعَونَ.",
    "ayah": 115,
    "surah": 37
  },
  {
    "text": "﴿عَلَيۡهِمَا﴾: أي: على ذِكْرِهِما الحَسَنِ.\n\n﴿فِي ٱلۡـَٔاخِرِينَ﴾: في الأمَمِ الَّتي جاءَتْ بَعْدَهُما.",
    "ayah": 119,
    "surah": 37
  },
  {
    "text": "﴿بَعۡلࣰا﴾: وهو اسْمٌ لِصَنَمٍ كانُوا يَعْبُدُونَهُ.\n\n﴿وَتَذَرُونَ﴾: تَتْرُكُونَ.",
    "ayah": 125,
    "surah": 37
  },
  {
    "text": "﴿لَمُحۡضَرُونَ﴾: أي: لِلْحِسابِ والعِقابِ.",
    "ayah": 127,
    "surah": 37
  },
  {
    "text": "﴿عَلَيۡهِ﴾: أي: على ذِكْرِه الحَسَنِ.\n\n﴿فِي ٱلۡـَٔاخِرِينَ﴾: في الأُمَمِ الَّتي جاءَتْ بَعْدَهُ.",
    "ayah": 129,
    "surah": 37
  },
  {
    "text": "﴿فِي ٱلۡغَـٰبِرِينَ﴾: الباقِينَ في العذابِ.",
    "ayah": 135,
    "surah": 37
  },
  {
    "text": "﴿دَمَّرۡنَا﴾: أهْلَكْنا.\n\n﴿ٱلۡـَٔاخَرِينَ﴾: الباقِينَ مِن قَومِ لُوطٍ عَلَيهِ السَّلامُ الَّذينَ لم يُؤْمِنُوا بِهِ.",
    "ayah": 136,
    "surah": 37
  },
  {
    "text": "﴿مُّصۡبِحِينَ﴾: داخِلِينَ وقْتَ الصَّباحِ.",
    "ayah": 137,
    "surah": 37
  },
  {
    "text": "﴿أَبَقَ﴾: هَرَبَ.\n\n﴿ٱلۡمَشۡحُونِ﴾: المَمْلُوءِ.",
    "ayah": 140,
    "surah": 37
  },
  {
    "text": "﴿فَسَاهَمَ﴾: اقْتَرَعَ وقَبِلَ القُرْعَةَ.\n\n﴿ٱلۡمُدۡحَضِينَ﴾: المَغْلُوبِينَ بالقُرْعَةِ.",
    "ayah": 141,
    "surah": 37
  },
  {
    "text": "﴿فَٱلۡتَقَمَهُ﴾: فابْتَلَعَه.\n\n﴿مُلِيمࣱ﴾: آتٍ بما يُلامُ عَلَيهِ.",
    "ayah": 142,
    "surah": 37
  },
  {
    "text": "﴿ٱلۡمُسَبِّحِينَ﴾: بِذِكْرِ اللهِ وكَثْرةِ العِبادةِ.",
    "ayah": 143,
    "surah": 37
  },
  {
    "text": "﴿لَلَبِثَ﴾: لمَكَثَ.",
    "ayah": 144,
    "surah": 37
  },
  {
    "text": "﴿فَنَبَذۡنَـٰهُ﴾: طَرَحْناه.\n\n﴿بِٱلۡعَرَآءِ﴾: بِأرْضٍ خاليةٍ عاريةٍ من الشَّجرِ والبناءِ.\n\n﴿سَقِيمࣱ﴾: ضَعِيفُ البَدَنِ بسَبِبِ حَبْسِهِ في بَطْنِ الحُوتِ.",
    "ayah": 145,
    "surah": 37
  },
  {
    "text": "﴿يَقۡطِينࣲ﴾: القَرْعِ.",
    "ayah": 146,
    "surah": 37
  },
  {
    "text": "﴿إِفۡكِهِمۡ﴾: من كَذِبِهِم وافْتِرائِهِم.",
    "ayah": 151,
    "surah": 37
  },
  {
    "text": "﴿أَصۡطَفَى﴾: هل اخْتارَ؟",
    "ayah": 153,
    "surah": 37
  },
  {
    "text": "﴿سُلۡطَـٰنࣱ مُّبِينࣱ﴾: حُجَّةٌ واضِحةٌ.",
    "ayah": 156,
    "surah": 37
  },
  {
