[
  {
    "text": "﴿كُوِّرَتۡ﴾: لُفَّتْ، وذَهَبَ ضَوْءُها.",
    "ayah": 1,
    "surah": 81
  },
  {
    "text": "﴿ٱنكَدَرَتۡ﴾: تَناثَرَتْ، فَذَهَبَ نُورُها.",
    "ayah": 2,
    "surah": 81
  },
  {
    "text": "﴿سُيِّرَتۡ﴾: سُيِّرَتْ عن وجْهِ الأرْضِ فَصارَتْ هَباءً.",
    "ayah": 3,
    "surah": 81
  },
  {
    "text": "﴿ٱلۡعِشَارُ﴾: النُوقُ الحوامِلُ.\n\n﴿عُطِّلَتۡ﴾: تُرِكَتْ وأُهْمِلَتْ.",
    "ayah": 4,
    "surah": 81
  },
  {
    "text": "﴿ٱلۡوُحُوشُ﴾: الحيواناتُ الوَحْشِيِّةُ.\n\n﴿حُشِرَتۡ﴾: جُمِعَتْ واخْتَلَطَتْ، لِيَقْتَصَّ اللهُ مِن بَعْضِها لِبَعْضٍ.",
    "ayah": 5,
    "surah": 81
  },
  {
    "text": "﴿سُجِّرَتۡ﴾: أُوقِدَتْ.",
    "ayah": 6,
    "surah": 81
  },
  {
    "text": "﴿زُوِّجَتۡ﴾: قُرِنَتْ بأَمثالِها.",
    "ayah": 7,
    "surah": 81
  },
  {
    "text": "﴿ٱلۡمَوۡءُۥدَةُ﴾: الطِّفْلةُ المدفُونةُ حَيَةً.\n\n﴿سُئِلَتۡ﴾: سُؤالَ تَطْيِيبٍ لها ولَومٍ لِوائِدِها.",
    "ayah": 8,
    "surah": 81
  },
  {
    "text": "﴿ٱلصُّحُفُ﴾: صُحُفُ الأَعْمالِ.\n\n﴿نُشِرَتۡ﴾: عُرِضَتْ.",
    "ayah": 10,
    "surah": 81
  },
  {
    "text": "﴿كُشِطَتۡ﴾: أُزِيلَتْ مِن مَّكانِها.",
    "ayah": 11,
    "surah": 81
  },
  {
    "text": "﴿سُعِّرَتۡ﴾: أُوقِدَتْ.",
    "ayah": 12,
    "surah": 81
  },
  {
    "text": "﴿أُزۡلِفَتۡ﴾: قُرِّبَتْ مِن أهْلِها.",
    "ayah": 13,
    "surah": 81
  },
  {
    "text": "﴿أَحۡضَرَتۡ﴾: قَدَّمَتْ من خَيرٍ أو شَرٍّ.",
    "ayah": 14,
    "surah": 81
  },
  {
    "text": "﴿بِٱلۡخُنَّسِ﴾: بِالنُّجُومِ المُخْتَفِيَةِ أنْوارُها نهارًا.",
    "ayah": 15,
    "surah": 81
  },
  {
    "text": "﴿ٱلۡجَوَارِ﴾: الجارِيةِ.\n\n﴿ٱلۡكُنَّسِ﴾: المسْتَتِرَةِ في أبْراجِها.",
    "ayah": 16,
    "surah": 81
  },
  {
    "text": "﴿عَسۡعَسَ﴾: أقْبَلَ بِظَلامِهِ.",
    "ayah": 17,
    "surah": 81
  },
  {
    "text": "﴿تَنَفَّسَ﴾: ظَهَرَ ضِياؤُه.",
    "ayah": 18,
    "surah": 81
  },
  {
    "text": "﴿إِنَّهُۥ﴾: إنَّ القُرآنَ.\n\n﴿رَسُولࣲ كَرِيمࣲ﴾: هو جِبْرِيلُ -عَلَيه السَّلامُ-.",
    "ayah": 19,
    "surah": 81
  },
  {
    "text": "﴿ذِي ٱلۡعَرۡشِ﴾: اللهِ.\n\n﴿مَكِينࣲ﴾: صاحبِ مَكانَةٍ رَفِيعَةٍ.",
    "ayah": 20,
    "surah": 81
  },
  {
    "text": "﴿ثَمَّ﴾: هُناكَ.\n\n﴿أَمِينࣲ﴾: مُؤْتَمَنٍ على الوَحْيِ الَّذِي يَنْزِلُ بِه.",
    "ayah": 21,
    "surah": 81
  },
  {
    "text": "﴿صَاحِبُكُم﴾: مُحَمَّدٌ ﷺ الَّذِي تَعْرِفُونَهُ.",
    "ayah": 22,
    "surah": 81
  },
  {
    "text": "﴿وَلَقَدۡ رَءَاهُ﴾: ولَقَدْ رَأى مُحَمَّدٌ جِبْرِيلَ.\n\n﴿بِٱلۡأُفُقِ ٱلۡمُبِينِ﴾: بالأُفُقِ العَظِيمِ.",
    "ayah": 23,
    "surah": 81
  },
  {
    "text": "﴿عَلَى ٱلۡغَيۡبِ﴾: بِتَبْلِيغ الوَحْيِ.\n\n﴿بِضَنِينࣲ﴾: ببَخِيلٍ.",
    "ayah": 24,
    "surah": 81
  },
  {
    "text": "﴿رَّجِيمࣲ﴾: مَطْرُودٍ منِ رَّحْمَةِ اللهِ.",
    "ayah": 25,
    "surah": 81
  },
  {
    "text": "﴿فَأَيۡنَ تَذۡهَبُونَ﴾: فَأَينَ تَذْهَبُ بِكُم عُقُولُكُم فَي التَّكْذِيبِ بالقُرآنِ بَعْدَ هذِه الحُجَجِ القاطِعَةِ؟",
    "ayah": 26,
    "surah": 81
